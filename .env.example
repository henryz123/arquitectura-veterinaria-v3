# Plantilla de desarrollo local. Copiar a .env.local (ignorado por Git) y completar secretos propios.
# No copiar credenciales de otro equipo ni subir .env.local a GitHub.
# Solo demo local: nunca utilizar datos reales de pacientes ni clientes.
AV_DB_URL=jdbc:postgresql://localhost:5432/arquitectura_veterinaria
AV_DB_USER=av_app
AV_DB_PASSWORD=
AV_MIGRATION_DB_USER=av_schema_owner
AV_MIGRATION_DB_PASSWORD=
AV_FLYWAY_ENABLED=false
AV_FLYWAY_TARGET=034
AV_SECURE_COOKIE=false
AV_LOCAL_CLIENT_AUTO_ACTIVATE=false
AV_LOCAL_LINK_BASE_URL=http://127.0.0.1:4200

# Opcionales: únicamente pruebas y semillas sintéticas autorizadas.
